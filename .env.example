# Copie os valores para variáveis de ambiente; não envie segredos ao repositório.
GEMINI_API_KEY=
GROQ_API_KEY=
# SERVICE_KEY_<CHAMADOR>= para cada serviço chamador aceito (nenhum definido ainda)
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_TIMEOUT_SECONDS=60
MAX_CONCURRENT_ANALYSES=4
DOCS_ENABLED=true

ENVIRONMENT=LOCAL
DEBUG_ADMIN_SUBS=

# Validação do JWT de admin (RS256/JWKS, emitido pelo api-auth).
JWT_JWKS_URL=http://localhost:8002/.well-known/jwks.json
JWT_ISSUER=solaria-auth
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Telemetria OpenTelemetry (OTLP/HTTP -> otel-collector); mesmos nomes do api-core.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SERVICE_VERSION=dev
DEPLOYMENT_ENVIRONMENT=local
OTEL_TRACES_SAMPLING_PROBABILITY=1.0
# OTEL_SDK_DISABLED=true  -> desliga a telemetria (testes)

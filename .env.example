# Copie os valores para variáveis de ambiente; não envie segredos ao repositório.
GOOGLE_REGISTRY_URL=
REGISTRY_CONSUMER_TOKEN=
REGISTRY_TIMEOUT_SECONDS=10
REGISTRY_MAX_ATTEMPTS=3
JWT_JWK_SET_URI=http://localhost:8081/.well-known/jwks.json
JWT_ISSUER=solaria-auth
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_TIMEOUT_SECONDS=60
MAX_CONCURRENT_ANALYSES=4
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# OpenTelemetry is opt-in; coordinate cluster activation with infrastructure.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
DEPLOYMENT_ENVIRONMENT=local
